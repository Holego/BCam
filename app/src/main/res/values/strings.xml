    <!-- About -->
    <string name="row_about">About</string>
    <string name="about_title">About this app</string>
    <string name="about_intro">Background Camera is an application for simple video recording in the background. After a one-time setup, recording is started and stopped from a home-screen widget or from the notification, without opening the application, and continues while the screen is off.</string>
    <string name="about_privacy_title">Your data stays on your device</string>
    <string name="about_privacy_body">The application does not collect, store or transmit any data. There is no account, no analytics, no crash reporting and no telemetry, and this build declares no network permission at all. Recordings are written directly into the folder you select and never leave the device. Settings are kept in the application\'s private storage.\n\nOnly the permissions required for recording are requested: camera, microphone (only when audio recording is enabled), notifications for the recording indicator, and a wake lock so that recording continues while the screen is off.</string>
    <string name="about_source_title">Source code</string>
    <string name="about_source_body">This app is open source. The build published on F-Droid and GitHub contains no ads, no billing and no network access at all.</string>
